@{
    ViewData["Title"] = "Administration";
}

<div class="container-fluid py-4">

    <h2>Administration</h2>

    <p class="text-muted">
        Administrative workspace for SecureCert Portal.
    </p>

    <div class="row g-3">

        @* Управление на организации *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5>Organizations</h5>

                    <p class="text-muted">
                        Manage registered organizations.
                    </p>

                    <a asp-area=""
                       asp-controller="Organizations"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Organizations
                    </a>

                </div>
            </div>
        </div>

        @* Управление на клиентски потребители *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5>Users</h5>

                    <p class="text-muted">
                        Manage client user accounts.
                    </p>

                    <a asp-area=""
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Users
                    </a>

                </div>
            </div>
        </div>

        @* Административен преглед на сертификати *@
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5>Certificates</h5>

                    <p class="text-muted">
                        View and review certificate submissions.
                    </p>

                    <a asp-area=""
                       asp-controller="Certificates"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Certificates
                    </a>

                </div>
            </div>
        </div>

    </div>
</div>
