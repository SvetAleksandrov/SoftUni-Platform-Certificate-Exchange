@model IEnumerable<SoftUni_Platform_Certificate_Exchange.Models.CertificateSubmission>

@{
    ViewData["Title"] = "Certificates";
}

<div class="container mt-4">

    <h2>SSL/TLS Certificates</h2>


    @* Отваря формуляра за качване на сертификат *@
    <a asp-controller="Certificates"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Upload Certificate
    </a>


    <p class="text-muted">
        Manage certificates submitted by client organizations.
    </p>

    @* Проверяваме дали има сертификати *@
    @if (Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Organization</th>
                        <th>Hostname</th>
                        <th>Valid Until</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @* Обхождаме сертификатите от SQL Server *@
                    @foreach (var certificate in Model)
                    {
                        <tr>
                            <td>@certificate.Id</td>

                            <td>@certificate.Organization.Name</td>

                            <td>@certificate.TargetHostname</td>

                            <td>
                                @(certificate.NotAfterUtc?.ToString("dd.MM.yyyy")
                                                        ?? "N/A")
                    </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @certificate.Status
                                </span>
                            </td>

                            <td>
                                @* Отваря детайлите на сертификата *@
                                <a asp-controller="Certificates"
                                   asp-action="Details"
                                   asp-route-id="@certificate.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>
                        </tr>
                                }
                </tbody>

            </table>
        </div>
    }
    else
    {
        @* Съобщение при липса на сертификати *@
        <div class="alert alert-info">
            No certificates have been submitted yet.
        </div>
    }

</div>
