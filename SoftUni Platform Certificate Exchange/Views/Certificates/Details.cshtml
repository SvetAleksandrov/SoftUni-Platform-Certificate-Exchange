@using SoftUni_Platform_Certificate_Exchange.Models

@model SoftUni_Platform_Certificate_Exchange.Models.CertificateSubmission

@{
    ViewData["Title"] = "Certificate Details";
}

<div class="container mt-4">

    <h2>Certificate Details</h2>

    <p class="text-muted">
        SSL/TLS certificate information and validity.
    </p>

    <div class="card">
        <div class="card-header">
            <strong>Certificate #@Model.Id</strong>
        </div>

        <div class="card-body">

            @* Показваме данните на сертификата *@
            <dl class="row">

                <dt class="col-sm-4">Organization</dt>
                <dd class="col-sm-8">@Model.Organization.Name</dd>

                <dt class="col-sm-4">Target Hostname</dt>
                <dd class="col-sm-8">@Model.TargetHostname</dd>

                <dt class="col-sm-4">Subject</dt>
                <dd class="col-sm-8">@(Model.Subject ?? "N/A")</dd>

                <dt class="col-sm-4">Issuer</dt>
                <dd class="col-sm-8">@(Model.Issuer ?? "N/A")</dd>

                <dt class="col-sm-4">Thumbprint</dt>
                <dd class="col-sm-8 text-break">
                    @(Model.Thumbprint ?? "N/A")
                </dd>

                <dt class="col-sm-4">Valid From (UTC)</dt>
                <dd class="col-sm-8">
                    @(Model.NotBeforeUtc?.ToString("dd.MM.yyyy HH:mm")
                                        ?? "N/A")
                </dd>

                <dt class="col-sm-4">Valid Until (UTC)</dt>
                <dd class="col-sm-8">
                    @(Model.NotAfterUtc?.ToString("dd.MM.yyyy HH:mm")
                                        ?? "N/A")
                </dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-primary">
                        @Model.Status
                    </span>
                </dd>

                <dt class="col-sm-4">Description</dt>
                <dd class="col-sm-8">
                    @(Model.Description ?? "No description")
                </dd>

            </dl>
        </div>
    </div>

    @{
        // Получаваме информацията за прегледа от Controller
        var review = ViewBag.Review as CertificateReview;
        var reviewerEmail = ViewBag.ReviewerEmail as string;
    }

    @* Показваме историята на одобрението *@
    <div class="card mt-4">
        <div class="card-header">
            <strong>Certificate Review History</strong>
        </div>

        <div class="card-body">

            @if (review != null)
            {
                <dl class="row">

                    @* Решение на служителя *@
                    <dt class="col-sm-4">Decision</dt>
                    <dd class="col-sm-8">
                        @if (review.Decision == CertificateReviewDecision.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                    </dd>

                    @* Служител, извършил прегледа *@
                    <dt class="col-sm-4">Reviewed By</dt>
                    <dd class="col-sm-8">
                        @(reviewerEmail ?? review.ReviewedByUserId)
                    </dd>

                    @* Дата на одобрението или отказа *@
                    <dt class="col-sm-4">Reviewed At</dt>
                    <dd class="col-sm-8">
                        @review.ReviewedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC
                    </dd>

                    @* Коментар към решението *@
                    <dt class="col-sm-4">Comment</dt>
                    <dd class="col-sm-8">
                        @(review.Comment ?? "No comment provided.")
                    </dd>

                </dl>
            }
            else
            {
                @* Сертификатът все още не е обработен *@
                <div class="alert alert-info mb-0">
                    No review decision has been recorded yet.
                </div>
            }

        </div>
    </div>


    @* Бутон Review само за Admin и необработени сертификати *@
    @if (User.IsInRole("Admin") &&
        (Model.Status == CertificateStatus.Submitted ||
        Model.Status == CertificateStatus.UnderReview))
    {
        <a asp-controller="Certificates"
           asp-action="Review"
           asp-route-id="@Model.Id"
           class="btn btn-primary mt-3">
            Review Certificate
        </a>
    }

    @* Изтегляне на публичния SSL/TLS сертификат *@
    @if (!string.IsNullOrWhiteSpace(Model.StorageKey))
    {
        <a asp-controller="Certificates"
           asp-action="Download"
           asp-route-id="@Model.Id"
           class="btn btn-outline-success mt-3">
            Download Certificate
        </a>
    }

    @* Редакция само на Draft и Submitted сертификати *@
    @if (Model.Status == CertificateStatus.Draft ||
        Model.Status == CertificateStatus.Submitted)
    {
        <a asp-controller="Certificates"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary mt-3">
            Edit Certificate
        </a>
    }

    @* Връщане към списъка *@
    <a asp-controller="Certificates"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Back to Certificates
    </a>

</div>
