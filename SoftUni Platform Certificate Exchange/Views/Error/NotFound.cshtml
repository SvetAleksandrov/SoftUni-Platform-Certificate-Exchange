@{
    ViewData["Title"] = "404 - Page Not Found";
}

<div class="container text-center py-5">

    <h1 class="display-1 fw-bold text-primary">
        404
    </h1>

    <h2 class="mb-3">
        Page Not Found
    </h2>

    <p class="text-muted mb-4">
        The page you are looking for does not exist,
        has been moved, or is no longer available.
    </p>

    <a asp-area=""
       asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">
        Back to Home
    </a>

</div>
