@model SoftUni_Platform_Certificate_Exchange.ViewModels.OrganizationDetailsViewModel

@{
    ViewData["Title"] = "Organization Details";
}

<div class="container mt-4">

    <h2>@Model.Name</h2>

    @* Основна информация за организацията *@
    <div class="card mb-4">
        <div class="card-body">
            <p><strong>ID:</strong> @Model.Id</p>
            <p>
                <strong>Registration Number:</strong>
                @(Model.RegistrationNumber ?? "N/A")
            </p>

            <p>
                <strong>Status:</strong>
                @(Model.IsActive ? "Active" : "Inactive")
            </p>
        </div>
    </div>

    @* Списък с потребителите *@
    <h4>Assigned Users (@Model.Users.Count)</h4>

    <a asp-controller="Users"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Create Client User
    </a>

    @if (Model.Users.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.FirstName</td>
                        <td>@user.LastName</td>
                        <td>@user.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No users assigned to this organization.
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Back to Organizations
    </a>
</div>
