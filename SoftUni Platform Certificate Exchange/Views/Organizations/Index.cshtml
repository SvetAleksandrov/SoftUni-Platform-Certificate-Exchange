@model IEnumerable<SoftUni_Platform_Certificate_Exchange.Models.Organization>

@{
    ViewData["Title"] = "Organizations";

    // Текущите филтри
    string organizationSearch =
        ViewBag.OrganizationSearch as string ?? "";

    string registrationSearch =
        ViewBag.RegistrationSearch as string ?? "";

    string statusSearch =
        ViewBag.StatusSearch as string ?? "all";

    string groupBy = ViewBag.GroupBy as string ?? "none";
    string sort = ViewBag.Sort as string ?? "organization_asc";

    var organizations = Model.ToList();

    // Определяме следващата посока на сортиране
    string organizationNext = sort == "organization_asc"
        ? "organization_desc" : "organization_asc";

    string registrationNext = sort == "registration_asc"
        ? "registration_desc" : "registration_asc";

    string statusNext = sort == "status_asc"
        ? "status_desc" : "status_asc";

    // Визуално групиране по избраната колона
    var groups = organizations.GroupBy(o => groupBy switch
    {
        "organization" => o.Name,
        "registration" => o.RegistrationNumber ?? "N/A",
        "status" => o.IsActive ? "Active" : "Inactive",
        _ => "All"
    }).ToList();
}

<div class="container mt-4">

    <h2>Organization Management</h2>
    
    <p class="text-muted">
        Manage, search and organize client organizations.
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @* Административни действия *@
    <div class="mb-4">

        <a asp-action="Create"
           class="btn btn-primary">
            + Create Organization
        </a>

        <a asp-controller="Users"
           asp-action="Create"
           class="btn btn-outline-primary">
            + Create Client User
        </a>

        <a asp-controller="Users"
           asp-action="Index"
           class="btn btn-outline-secondary">
            View Users
        </a>

    </div>

    @* Един GET формуляр за всички филтри в таблицата *@
    <form asp-action="Index" method="get">

        @* Запазваме избраното сортиране *@
        <input type="hidden" name="sort" value="@sort" />

        <div class="d-flex justify-content-between
                    align-items-center mb-3">

            <div>
                Showing <strong>@organizations.Count</strong>
                organization(s)
            </div>

            <div class="d-flex align-items-center gap-2">

                <label for="groupBy" class="form-label mb-0">
                    Group By
                </label>

                <select id="groupBy"
                        name="groupBy"
                        class="form-select form-select-sm"
                        onchange="this.form.requestSubmit()">

                    <option value="none"
                            selected="@(groupBy == "none")">
                        No Grouping
                    </option>

                    <option value="organization"
                            selected="@(groupBy == "organization")">
                        Organization
                    </option>

                    <option value="registration"
                            selected="@(groupBy == "registration")">
                        Registration
                    </option>

                    <option value="status"
                            selected="@(groupBy == "status")">
                        Status
                    </option>

                </select>

                <a asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">
                    Reset
                </a>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-striped table-hover">

                @* Заглавия със сортиране *@
                <thead>

                    <tr class="table-dark">

                        <th>
                            <a asp-action="Index"
                               asp-route-organizationSearch="@organizationSearch"
                               asp-route-registrationSearch="@registrationSearch"
                               asp-route-statusSearch="@statusSearch"
                               asp-route-groupBy="@groupBy"
                               asp-route-sort="@organizationNext"
                               class="text-white text-decoration-none">

                                Organization

                                @(sort == "organization_asc" ? "↑" :
                                                                sort == "organization_desc" ? "↓" : "↕")
                            </a>
                        </th>

                        <th>
                            <a asp-action="Index"
                               asp-route-organizationSearch="@organizationSearch"
                               asp-route-registrationSearch="@registrationSearch"
                               asp-route-statusSearch="@statusSearch"
                               asp-route-groupBy="@groupBy"
                               asp-route-sort="@registrationNext"
                               class="text-white text-decoration-none">

                                Registration

                                @(sort == "registration_asc" ? "↑" :
                                                                sort == "registration_desc" ? "↓" : "↕")
                            </a>
                        </th>

                        <th>
                            <a asp-action="Index"
                               asp-route-organizationSearch="@organizationSearch"
                               asp-route-registrationSearch="@registrationSearch"
                               asp-route-statusSearch="@statusSearch"
                               asp-route-groupBy="@groupBy"
                               asp-route-sort="@statusNext"
                               class="text-white text-decoration-none">

                                Status

                                @(sort == "status_asc" ? "↑" :
                                                                sort == "status_desc" ? "↓" : "↕")
                            </a>
                        </th>

                        <th>Actions</th>

                    </tr>

                    @* Search директно под заглавията *@
                    <tr class="table-light">

                        @* Organization Search *@
                        <th>
                            <div class="input-group input-group-sm">

                                <input type="search"
                                       name="organizationSearch"
                                       value="@organizationSearch"
                                       class="form-control"
                                       placeholder="Search organization"
                                       aria-label="Search organization" />

                                <button type="submit"
                                        class="btn btn-outline-secondary"
                                        title="Search organization">
                                    &#128269;
                                </button>

                            </div>
                        </th>

                        @* Registration Search *@
                        <th>
                            <div class="input-group input-group-sm">

                                <input type="search"
                                       name="registrationSearch"
                                       value="@registrationSearch"
                                       class="form-control"
                                       placeholder="Search registration"
                                       aria-label="Search registration" />

                                <button type="submit"
                                        class="btn btn-outline-secondary"
                                        title="Search registration">
                                    &#128269;
                                </button>

                            </div>
                        </th>

                        @* Status Filter *@
                        <th>
                            <select name="statusSearch"
                                    class="form-select form-select-sm"
                                    aria-label="Filter status"
                                    onchange="this.form.requestSubmit()">

                                <option value="all"
                                        selected="@(statusSearch == "all")">
                                    All Statuses
                                </option>

                                <option value="active"
                                        selected="@(statusSearch == "active")">
                                    Active
                                </option>

                                <option value="inactive"
                                        selected="@(statusSearch == "inactive")">
                                    Inactive
                                </option>

                            </select>
                        </th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @if (!organizations.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                No organizations match the selected filters.
                            </td>
                        </tr>
                    }

                    @foreach (var group in groups)
                    {
                        @* Показваме заглавие при групиране *@
                        if (groupBy != "none")
                        {
                            <tr class="table-secondary">
                                <th colspan="4">
                                    @group.Key (@group.Count())
                                </th>
                            </tr>
                        }

                        @foreach (var organization in group)
                        {
                            <tr>

                                <td>@organization.Name</td>

                                <td>
                                    @(organization.RegistrationNumber ?? "N/A")
                                </td>

                                <td>
                                    @if (organization.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-action="Details"
                                       asp-route-id="@organization.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Users
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@organization.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@organization.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </form>

</div>
