@model SoftUni_Platform_Certificate_Exchange.ViewModels.OrganizationEditViewModel

@{
    ViewData["Title"] = "Edit Organization";
}

<div class="container mt-4">

    <h2>Edit Organization</h2>

    <p class="text-muted">
        Update client organization information.
    </p>

    @* Изпращаме актуализираните данни към Controller *@
    <form asp-controller="Organizations"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @* Запазваме ID на редактирания запис *@
        <input asp-for="Id" type="hidden" />

        @* Показваме общите грешки при валидация *@
        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        @* Име на организацията *@
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>

            <input asp-for="Name" class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        @* Регистрационен номер *@
        <div class="mb-3">
            <label asp-for="RegistrationNumber"
                   class="form-label"></label>

            <input asp-for="RegistrationNumber"
                   class="form-control" />

            <span asp-validation-for="RegistrationNumber"
                  class="text-danger"></span>
        </div>

        @* Активиране или деактивиране на организация *@
        <div class="form-check mb-3">

            <input asp-for="IsActive"
                   class="form-check-input" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>
        </div>

        @* Записване на промените *@
        <button type="submit" class="btn btn-success">
            Save Changes
        </button>

        @* Връщане без запис *@
        <a asp-controller="Organizations"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>

@* Активира клиентската валидация *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
