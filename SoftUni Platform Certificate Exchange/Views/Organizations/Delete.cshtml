@model SoftUni_Platform_Certificate_Exchange.Models.Organization

@{
    ViewData["Title"] = "Delete Organization";
}

<div class="container mt-4">

    <h2>Delete Organization</h2>

    @* Показваме грешка, ако изтриването е отказано *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @* Информация за избраната организация *@
    <div class="card mb-3">
        <div class="card-body">
            <h5>@Model.Name</h5>

            <p>
                Registration Number:
                @(Model.RegistrationNumber ?? "N/A")
            </p>

            <p>
                Status:
                @(Model.IsActive ? "Active" : "Inactive")
            </p>
        </div>
    </div>

    @* Блокираме изтриване при свързани записи *@
    @if (ViewBag.HasDependencies == true)
    {
        <div class="alert alert-warning">
            This organization cannot be deleted because
            it has related users or certificates.
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            Are you sure you want to permanently
            delete this organization?
        </div>

        @* POST форма за потвърждение на изтриването *@
        <form asp-controller="Organizations"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit" class="btn btn-danger">
                Delete Organization
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    }

    @* Връщане към списъка при блокирано изтриване *@
    @if (ViewBag.HasDependencies == true)
    {
        <a asp-action="Index" class="btn btn-secondary">
            Back to Organizations
        </a>
    }

</div>
