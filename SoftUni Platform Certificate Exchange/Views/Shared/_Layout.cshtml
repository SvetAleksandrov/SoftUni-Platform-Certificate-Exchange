<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SoftUni_Platform_Certificate_Exchange</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SoftUni_Platform_Certificate_Exchange.styles.css" asp-append-version="true" />
</head>
<body>
    <header>

        @{
            // Определяме коя функционална област е активна
            var activeController =
            ViewContext.RouteData.Values["controller"]?.ToString();
        }

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom mb-3">
            <div class="portal-shell portal-header-inner">

                @* Лого - вляво *@
                <a class="navbar-brand fw-semibold"
                   asp-controller="Home"
                   asp-action="Index">
                    SecureCert Portal
                </a>

                @* Мобилно меню *@
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#portalNavigation"
                        aria-controls="portalNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse portal-navbar-collapse"
                     id="portalNavigation">

                    @* Основните бутони са центрирани *@
                    <ul class="navbar-nav portal-nav-links">

                        <li class="nav-item">
                            <a class="nav-link portal-nav-link portal-nav-home @(activeController == "Home" ? "is-active" : "")"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link portal-nav-link portal-nav-organizations @(activeController == "Organizations" ? "is-active" : "")"
                                   asp-controller="Organizations"
                                   asp-action="Index">
                                    Organizations
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link portal-nav-link portal-nav-users @(activeController == "Users" ? "is-active" : "")"
                                   asp-controller="Users"
                                   asp-action="Index">
                                    Users
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("Client"))
                        {
                            <li class="nav-item">
                                <a class="nav-link portal-nav-link portal-nav-certificates @(activeController == "Certificates" ? "is-active" : "")"
                                   asp-controller="Certificates"
                                   asp-action="Index">
                                    Certificates
                                </a>
                            </li>
                        }

                    </ul>

                    @* Вход и изход - вдясно *@
                    <div class="portal-account">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="Account"
                               asp-action="Login"
                               class="btn btn-primary btn-sm">
                                Login
                            </a>
                        }

                    </div>

                </div>
            </div>
        </nav>

    </header>

    @* Общ контейнер с адаптивна ширина и странични отстояния *@
    <div class="portal-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted">
        <div class="portal-shell">

            @* Footer на SecureCert Portal *@
            &copy; 2026 - SecureCert Portal -

            <a asp-controller="Home"
               asp-action="Privacy">
                Security &amp; Privacy
            </a>

        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Общ Live Search за Organizations, Users и Certificates *@
    <script src="~/js/live-table-filters.js"
            asp-append-version="true"
            defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
