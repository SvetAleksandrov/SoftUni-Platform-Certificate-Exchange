@model IEnumerable<SoftUni_Platform_Certificate_Exchange.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="container mt-4">

    <h2>User Management</h2>

    <p class="text-muted">
        Manage users and their assigned organizations.
    </p>

    @* Отваряме формуляра за нов потребител *@
    <a asp-controller="Users"
       asp-action="Create"
       class="btn btn-primary mb-3">
        + Create Client User
    </a>

    @* Показваме броя потребители *@
    <p>Total Users: <strong>@Model.Count()</strong></p>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Email</th>
                        <th>Organization</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.FirstName</td>
                            <td>@user.LastName</td>
                            <td>@user.Email</td>

                            <td>
                                @if (user.OrganizationId.HasValue)
                                {
                                    @* Връзка към организацията *@
                                    <a asp-controller="Organizations"
                                       asp-action="Details"
                                       asp-route-id="@user.OrganizationId.Value">
                                        @user.OrganizationName
                                    </a>
                                }
                                else
                                {
                                    @* Вътрешен потребител без организация *@
                                    <span class="text-muted">
                                        Internal / System
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No users found.
        </div>
    }

</div>
