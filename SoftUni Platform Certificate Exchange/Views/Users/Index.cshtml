@model IEnumerable<SoftUni_Platform_Certificate_Exchange.ViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "User Management";

    // Текущите филтри
    string firstNameSearch = ViewBag.FirstNameSearch as string ?? "";
    string lastNameSearch = ViewBag.LastNameSearch as string ?? "";
    string emailSearch = ViewBag.EmailSearch as string ?? "";
    string phoneSearch = ViewBag.PhoneSearch as string ?? "";
    string departmentSearch = ViewBag.DepartmentSearch as string ?? "";
    string jobTitleSearch = ViewBag.JobTitleSearch as string ?? "";
    string organizationSearch = ViewBag.OrganizationSearch as string ?? "";

    string sort = ViewBag.Sort as string ?? "lastname_asc";
    string groupBy = ViewBag.GroupBy as string ?? "none";

    var users = Model.ToList();

    // Колоните в желаната последователност
    var columns = new[]
    {
        new { Key = "firstname", Label = "First Name",
              Search = "firstNameSearch", Value = firstNameSearch },

        new { Key = "lastname", Label = "Last Name",
              Search = "lastNameSearch", Value = lastNameSearch },

        new { Key = "email", Label = "Email",
              Search = "emailSearch", Value = emailSearch },

        new { Key = "phone", Label = "Phone",
              Search = "phoneSearch", Value = phoneSearch },

        new { Key = "department", Label = "Department",
              Search = "departmentSearch", Value = departmentSearch },

        new { Key = "jobtitle", Label = "Job Title",
              Search = "jobTitleSearch", Value = jobTitleSearch },

        new { Key = "organization", Label = "Organization",
              Search = "organizationSearch", Value = organizationSearch }
    };

    // Колоните за групиране
    var groupOptions = new[]
    {
        new { Value = "none", Label = "No Grouping" },
        new { Value = "firstname", Label = "First Name" },
        new { Value = "lastname", Label = "Last Name" },
        new { Value = "email", Label = "Email" },
        new { Value = "phone", Label = "Phone" },
        new { Value = "department", Label = "Department" },
        new { Value = "jobtitle", Label = "Job Title" },
        new { Value = "organization", Label = "Organization" }
    };

    // Групиране след филтрирането в SQL Server
    var groups = users.GroupBy(u => groupBy switch
    {
        "firstname" => u.FirstName,
        "lastname" => u.LastName,
        "email" => u.Email,
        "phone" => u.PhoneNumber ?? "N/A",
        "department" => u.Department ?? "N/A",
        "jobtitle" => u.JobTitle ?? "N/A",
        "organization" => u.OrganizationName ?? "Internal / System",
        _ => "All"
    }).ToList();
}

<div class="container-fluid mt-4">

    <h2>User Management</h2>

    <p class="text-muted">
        Manage client users and their assigned organizations.
    </p>

    @* Съобщения след Edit и Delete *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="mb-4">
        <a asp-controller="Users"
           asp-action="Create"
           class="btn btn-primary">
            Create Client User
        </a>
    </div>

    @* Общ формуляр за Live Search, Sorting и Group By *@
    <form id="userFilters"
          data-live-filters
          action="@Url.Action("Index", "Users")"
          method="get">

        <input type="hidden"
               name="sort"
               id="sortValue"
               value="@sort" />

        <div class="d-flex justify-content-between
                    align-items-center mb-3 flex-wrap gap-2">

            <span>
                Showing <strong data-live-count>@users.Count</strong>
                user(s)
            </span>

            <div class="d-flex align-items-center gap-2">

                <label for="groupBy" class="mb-0">Group By</label>

                <select name="groupBy"
                        id="groupBy"
                        class="form-select form-select-sm">

                    @foreach (var option in groupOptions)
                    {
                        <option value="@option.Value"
                                selected="@(groupBy == option.Value)">
                            @option.Label
                        </option>
                    }
                </select>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-secondary">
                    Reset
                </a>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle"
                   style="min-width: 1450px;">

                <thead>

                    @* Първи ред - заглавия със Sorting *@
                    <tr class="table-dark">

                        @foreach (var column in columns)
                        {
                            string nextSort =
                            sort == column.Key + "_asc"
                            ? column.Key + "_desc"
                            : column.Key + "_asc";

                            string arrow =
                            sort == column.Key + "_asc" ? "↑" :
                            sort == column.Key + "_desc" ? "↓" : "↕";

                            <th>
                                <button type="submit"
                                        class="btn btn-link text-white text-decoration-none p-0"
                                        onclick="document.getElementById('sortValue').value='@nextSort'">
                                    @column.Label @arrow
                                </button>
                            </th>
                        }

                        <th>Action</th>
                    </tr>

                    @* Втори ред - Search във всяка информационна колона *@
                    <tr class="table-light">

                        @foreach (var column in columns)
                        {
                            <th>
                                <input type="search"
                                       name="@column.Search"
                                       value="@column.Value"
                                       class="form-control form-control-sm"
                                       placeholder="Search @column.Label"
                                       aria-label="Search @column.Label" />
                            </th>
                        }

                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @if (!users.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center">
                                No users match the selected filters.
                            </td>
                        </tr>
                    }

                    @foreach (var group in groups)
                    {
                        @if (groupBy != "none")
                        {
                            <tr class="table-secondary">
                                <th colspan="8">
                                    @group.Key (@group.Count())
                                </th>
                            </tr>
                        }

                        @foreach (var user in group)
                        {
                            <tr>
                                <td>@user.FirstName</td>
                                <td>@user.LastName</td>
                                <td>@user.Email</td>

                                <td>@(user.PhoneNumber ?? "N/A")</td>

                                <td>@(user.Department ?? "N/A")</td>

                                <td>@(user.JobTitle ?? "N/A")</td>

                                <td>
                                    @if (user.OrganizationId.HasValue)
                                    {
                                        <a asp-controller="Organizations"
                                           asp-action="Details"
                                           asp-route-id="@user.OrganizationId.Value">
                                            @user.OrganizationName
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Internal / System
                                        </span>
                                    }
                                </td>

                                <td>
                                    @* Действия само за клиентски акаунти *@
                                    @if (user.OrganizationId.HasValue)
                                    {
                                        <div class="d-flex gap-1">
                                            <a asp-controller="Users"
                                               asp-action="Edit"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-controller="Users"
                                               asp-action="Delete"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>
